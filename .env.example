# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit file .env.
# Dapatkan API key di https://aistudio.google.com/apikey
#
# PENTING: jangan beri prefix VITE_ — variabel ber-prefix VITE_ akan dibundel ke browser
# dan API key Anda bisa dicuri siapa pun yang membuka DevTools.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

