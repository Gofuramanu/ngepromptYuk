# Salin file ini menjadi `.env` untuk local dev, atau masukkan ke Environment Variables
# pada dashboard Vercel (Production). JANGAN commit file `.env`.
#
# PENTING: JANGAN gunakan prefix `VITE_` untuk secret atau API key — variabel ber-prefix `VITE_`
# akan dibundel ke browser dan membocorkan kredensial Anda.

# --- 1. Database Multi-User & Auth (Supabase) ---
SUPABASE_URL=https://project-id-anda.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Opsional: kompatibel juga dengan prefix Next.js jika dipakai
# NEXT_PUBLIC_SUPABASE_URL=https://project-id-anda.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Kunci rahasia server (minimal 32 karakter acak) untuk mengenkripsi API Key milik user (AES-256-GCM)
CREDENTIAL_ENCRYPTION_KEY=ganti-dengan-random-hex-minimal-32-karakter

# --- 2. Fallback AI Gateway Bawaan Aplikasi (Dipakai hanya jika user belum login / belum set BYOK) ---
NINEROUTER_BASE_URL=https://openrouter.ai/api/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=openrouter/free

# --- Opsional (Fallback tambahan local dev) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
