# Salin file ini menjadi `.env` untuk local dev, atau masukkan ke Environment Variables
# pada dashboard Vercel (Production). JANGAN commit file `.env`.
#
# PENTING: JANGAN gunakan prefix `VITE_` — variabel ber-prefix `VITE_` akan dibundel
# ke browser dan membocorkan kredensial Anda.

# --- Konfigurasi Production & 9Router AI API Gateway ---
# URL endpoint 9Router (contoh lokal: http://localhost:20128/v1, production: https://router.domain-anda.com/v1)
NINEROUTER_BASE_URL=http://localhost:20128/v1
# API Key / Master Key dari 9Router
NINEROUTER_API_KEY=
# Nama model atau Combo yang dikonfigurasi di 9Router (contoh: gemini-3.5-flash-lite atau nama combo)
NINEROUTER_MODEL=gemini-3.5-flash-lite

# --- Opsional (Hanya untuk fallback local dev jika 9Router belum dijalankan) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
